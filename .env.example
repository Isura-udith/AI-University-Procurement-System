# Server Environment
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB Connection
# Local MongoDB connection (Default):
MONGODB_URI=mongodb://127.0.0.1:27017/uwu_procurement
# Cloud MongoDB Atlas connection string template:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_name>.mongodb.net/<database_name>?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_access_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Email Server (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_email_app_password_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis Cache
REDIS_URL=redis://127.0.0.1:6379

# Notification SLA Configuration
DIGEST_CRON=30 16 * * *
SLA_WARNING_HOURS=48
SLA_ESCALATION_HOURS=72
NOTIFICATION_FROM_NAME="UWU Smart Procurement"
DEBRIEFING_REQUEST_DAYS=3
DEBRIEFING_CONCLUDE_DAYS=5
STANDSTILL_PERIOD_DAYS=10

# Web Application (Vite Frontend)
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api/v1

# Multi-Tenant
DEFAULT_TENANT_ID=uwu-main

# Flowise AI Connection
FLOWISE_API_URL=http://localhost:3000/api/v1
FLOWISE_CHATFLOW_ID=your_flowise_chatflow_id_here
FLOWISE_API_KEY=your_flowise_api_key_here
FLOWISE_DOCUMENT_STORE_ID=your_flowise_document_store_id_here
INTERNAL_API_KEY=your_internal_api_key_here
HTTP_SECURITY_CHECK=false

# Flowise Advanced Configuration
FLOWISE_MEMORY_WINDOW_SIZE=10
CHAT_SESSION_MAX_AGE_DAYS=90
