{
  "name": "smart-procurement-system",
  "version": "1.2.0",
  "description": "AI-Driven Smart Procurement System for a Transparent and Predictive University - SaaS Multi-Tenant MERN Stack",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "cd apps/api && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:seed": "cd apps/api && npm run seed"
  },
  "keywords": ["procurement", "uwu", "gosl", "saas"],
  "author": "Isura Udith Gunawardhana <isuraudith@gmail.com>",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "turbo": "^2.9.10"
  },
  "dependencies": {
    "docker": "^1.0.0",
    "dotenv-cli": "^11.0.0"
  }
}
