# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/uwu_procurement

# JWT Security
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Email Server (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_email_password_or_app_password

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Multi-Tenant
DEFAULT_TENANT_ID=uwu-main

# Redis Cache
REDIS_URL=redis://127.0.0.1:6379

# Notification SLA Configuration
DIGEST_CRON=30 16 * * *
SLA_WARNING_HOURS=48
SLA_ESCALATION_HOURS=72
NOTIFICATION_FROM_NAME="UWU Smart Procurement"
DEBRIEFING_REQUEST_DAYS=3
DEBRIEFING_CONCLUDE_DAYS=5
STANDSTILL_PERIOD_DAYS=10
